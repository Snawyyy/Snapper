{
  "version": 6,
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "$env{HOME}/.cache/snapper/${sourceDirName}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "SNAPPER_LINTER": "/mnt/DataVault/tools/snawys_law/skills/snawys-law/scripts/snawys_lint.py"
      }
    },
    {
      "name": "release",
      "inherits": "debug",
      "binaryDir": "$env{HOME}/.cache/snapper/${sourceDirName}/build-release",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "relwithdebinfo",
      "inherits": "debug",
      "binaryDir": "$env{HOME}/.cache/snapper/${sourceDirName}/build-rel",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -fno-omit-frame-pointer"
      }
    },
    {
      "name": "sanitize",
      "inherits": "debug",
      "binaryDir": "$env{HOME}/.cache/snapper/${sourceDirName}/build-sanitize",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug" },
    { "name": "release", "configurePreset": "release" },
    { "name": "relwithdebinfo", "configurePreset": "relwithdebinfo" },
    { "name": "sanitize", "configurePreset": "sanitize" }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "relwithdebinfo",
      "configurePreset": "relwithdebinfo",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize",
      "output": { "outputOnFailure": true }
    }
  ]
}
